<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cream"
    android:fitsSystemWindows="true"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".diary.Diary2Fragment">

    <!-- Header Section -->
    <ImageView
        android:id="@+id/arrow_back_diary1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginTop="5dp"
        android:src="@drawable/baseline_arrow_back_24"
        android:padding="8dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/trash"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="5dp"
        android:src="@drawable/baseline_delete_24"
        android:padding="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/arrow_back_diary1"
        app:layout_constraintBottom_toBottomOf="@id/arrow_back_diary1" />

    <TextView
        android:id="@+id/judul"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:text="@string/title_main"
        android:fontFamily="@font/roboto_bold"
        android:textColor="@color/black"
        android:textSize="25sp"
        android:textStyle="bold"
        android:gravity="center"
        app:layout_constraintStart_toEndOf="@id/arrow_back_diary1"
        app:layout_constraintEnd_toStartOf="@id/trash"
        app:layout_constraintTop_toTopOf="@id/arrow_back_diary1"
        app:layout_constraintBottom_toBottomOf="@id/arrow_back_diary1"/>

    <!-- Image Slider Section -->
    <com.denzcoskun.imageslider.ImageSlider
        android:id="@+id/slider"
        android:layout_width="280dp"
        android:layout_height="180dp"
        android:layout_marginTop="24dp"
        app:auto_cycle="true"
        app:delay="0"
        app:period="6000"
        app:placeholder="@color/black"
        app:layout_constraintTop_toBottomOf="@id/judul"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ImageView
        android:id="@+id/silang"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/baseline_clear_24"
        android:elevation="5dp"
        app:layout_constraintStart_toStartOf="@id/slider"
        app:layout_constraintTop_toTopOf="@id/slider"/>

    <!-- Content Section -->
    <ImageView
        android:id="@+id/bottom_diary"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/slider"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:src="@drawable/bg_putih_diary"/>

    <EditText
        android:id="@+id/isi_diary"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:elevation="2dp"
        android:layout_margin="24dp"
        android:gravity="top"
        android:lineSpacingExtra="6dp"
        android:overScrollMode="always"
        android:scrollbars="vertical"
        android:background="@drawable/edit_text_bg"
        android:text=""
        android:textSize="14sp"
        android:fontFamily="@font/poppins_regular"
        app:layout_constraintTop_toTopOf="@id/bottom_diary"
        app:layout_constraintBottom_toBottomOf="@id/bottom_diary"
        app:layout_constraintStart_toStartOf="@id/bottom_diary"
        app:layout_constraintEnd_toEndOf="@id/bottom_diary"/>

    <!-- Decorative Images -->
    <ImageView
        android:layout_width="200dp"
        android:layout_height="150dp"
        android:src="@drawable/awan_biru"
        android:alpha="0.6"
        android:layout_marginEnd="170dp"
        android:layout_marginTop="10dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/bottom_diary"
        android:elevation="1dp"/>

    <ImageView
        android:layout_width="200dp"
        android:layout_height="150dp"
        android:src="@drawable/awan_pink"
        android:alpha="0.4"
        android:layout_marginStart="190dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/bottom_diary"
        android:elevation="1dp"/>

    <ImageView
        android:layout_width="520dp"
        android:layout_height="wrap_content"
        android:src="@drawable/bukit"
        android:alpha="0.5"
        android:scaleType="centerCrop"
        android:elevation="1dp"
        app:layout_constraintBottom_toBottomOf="@id/bottom_diary"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>
