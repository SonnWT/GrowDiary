            android:layout_width="80dp"
            android:layout_height="80dp"
            android:adjustViewBounds="true"
            android:src="@drawable/snake_decor"
            app:layout_constraintTop_toTopOf="@id/text_item_4"
            app:layout_constraintBottom_toBottomOf="@id/text_item_4"
            app:layout_constraintStart_toEndOf="@id/text_item_4"
            android:layout_marginStart="45dp" />

        <!-- Item 5: Mengamati Benda-benda Kecil (Pindah ke KANAN) -->
        <androidx.cardview.widget.CardView
            android:id="@+id/card_item_5"
            android:layout_width="120dp"
            android:layout_height="120dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="6dp"
            app:cardBackgroundColor="#F8E5CE"
            app:layout_constraintTop_toBottomOf="@id/card_item_4"
            app:layout_constraintEnd_toEndOf="@id/roadmap_path_image2"
            app:layout_constraintHorizontal_bias="0.85"
            android:layout_marginTop="90dp">

            <ImageView
                android:id="@+id/image_item5"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/baby_playing"
                android:scaleType="centerCrop"/>

            <ImageView
                android:id="@+id/delete_button_item_5"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:src="@drawable/ic_close_circle"
                android:background="@drawable/rounded_red_background"
                android:padding="5dp"
                android:layout_gravity="top|start"
                android:layout_margin="5dp"
                android:visibility="gone"
                android:elevation="2dp" />

        </androidx.cardview.widget.CardView>

        <TextView
            android:id="@+id/text_item_5"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Melambaikan\nTangan\n(Bye - Bye)"
            android:gravity="end"
            android:textAlignment="viewEnd"
            android:textColor="@color/aqua"
            android:textSize="14sp"
            android:fontFamily="@font/poppins_medium"
            app:layout_constraintEnd_toStartOf="@id/card_item_5"
            app:layout_constraintTop_toTopOf="@id/card_item_5"
            app:layout_constraintBottom_toBottomOf="@id/card_item_5"
            android:layout_marginEnd="16dp"
            android:layout_marginStart="70dp"
            app:layout_constrainedWidth="true" />

        <ImageView
