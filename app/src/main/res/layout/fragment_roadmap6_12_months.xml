<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#CCF2FD">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Gambar latar belakang roadmap -->
        <ImageView
            android:id="@+id/roadmap_path_image2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:src="@drawable/roadmap_blue"
            android:scaleType="fitXY"
            android:adjustViewBounds="true"
            app:layout_constraintWidth_percent="0.7"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="-20dp" />

        <!-- Item 3: Berusaha meraih Mainan (Dimulai dari KANAN) -->
        <androidx.cardview.widget.CardView
            android:id="@+id/card_item_3"
            android:layout_width="120dp"
            android:layout_height="120dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="6dp"
            app:cardBackgroundColor="#F8E5CE"
            app:layout_constraintTop_toTopOf="@id/roadmap_path_image2"
            app:layout_constraintEnd_toEndOf="@id/roadmap_path_image2"
            app:layout_constraintHorizontal_bias="0.85"
            android:layout_marginTop="140dp">

            <ImageView
                android:id="@+id/image_item3"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/baby_playing"
                android:scaleType="centerCrop"/>

            <ImageView
                android:id="@+id/delete_button_item_3"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:src="@drawable/ic_close_circle"
                android:background="@drawable/rounded_red_background"
                android:padding="5dp"
                android:layout_gravity="top|start"
                android:layout_margin="5dp"
                android:visibility="gone"
                android:elevation="2dp" />

        </androidx.cardview.widget.CardView>

        <TextView
            android:id="@+id/text_item_3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Memanggil\nMama Papa"
            android:gravity="end"
            android:textAlignment="viewEnd"
            android:textColor="@color/aqua"
            android:textSize="14sp"
            android:fontFamily="@font/poppins_medium"
            app:layout_constraintEnd_toStartOf="@id/card_item_3"
            app:layout_constraintTop_toTopOf="@id/card_item_3"
            app:layout_constraintBottom_toBottomOf="@id/card_item_3"
            android:layout_marginEnd="16dp"
            android:layout_marginStart="70dp"
            app:layout_constrainedWidth="true" />

        <ImageView
            android:id="@+id/camp_decor"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:adjustViewBounds="true"
            android:src="@drawable/camp_decor"
            app:layout_constraintTop_toTopOf="@id/text_item_3"
            app:layout_constraintBottom_toBottomOf="@id/text_item_3"
            app:layout_constraintEnd_toStartOf="@id/text_item_3"
            android:layout_marginEnd="15dp" />

        <!-- Item 4: Menoleh ke Suara Kerincingan (Pindah ke KIRI) -->
        <androidx.cardview.widget.CardView
            android:id="@+id/card_item_4"
            android:layout_width="120dp"
            android:layout_height="120dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="6dp"
            app:cardBackgroundColor="@android:color/white"
            app:layout_constraintTop_toBottomOf="@id/card_item_3"
            app:layout_constraintStart_toStartOf="@id/roadmap_path_image2"
            app:layout_constraintHorizontal_bias="0.15"
            android:layout_marginTop="90dp">

            <ImageView
                android:id="@+id/image_item4"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/baby_playing"
                android:scaleType="centerCrop"/>

            <ImageView
                android:id="@+id/delete_button_item_4"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:src="@drawable/ic_close_circle"
                android:background="@drawable/rounded_red_background"
                android:padding="5dp"
                android:layout_gravity="top|start"
                android:layout_margin="5dp"
                android:visibility="gone"
                android:elevation="2dp" />

        </androidx.cardview.widget.CardView>

        <TextView
            android:id="@+id/text_item_4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Menunjuk\nuntuk\nMeminta\nSesuatu"
            android:gravity="start"
            android:textAlignment="viewStart"
            android:textColor="@color/aqua"
            android:textSize="14sp"
            android:fontFamily="@font/poppins_medium"
            app:layout_constraintStart_toEndOf="@id/card_item_4"
            app:layout_constraintTop_toTopOf="@id/card_item_4"
            app:layout_constraintBottom_toBottomOf="@id/card_item_4"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="70dp"
            app:layout_constrainedWidth="true" />

        <ImageView
