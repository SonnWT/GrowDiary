            android:layout_height="80dp"
            android:adjustViewBounds="true"
            android:src="@drawable/lion_decor"
            app:layout_constraintTop_toTopOf="@id/text_item_5"
            app:layout_constraintBottom_toBottomOf="@id/text_item_5"
            app:layout_constraintEnd_toStartOf="@id/text_item_5"
            android:layout_marginEnd="15dp" />

        <!-- Item 6: Terlentang Sendiri (Pindah ke KIRI) -->
